{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:goliath:control-plane:v2",
  "title": "Goliath Control Plane v2",
  "oneOf": [
    { "$ref": "#/$defs/executionAction" },
    { "$ref": "#/$defs/executionReceipt" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "allOf": [
        { "pattern": "^(?!/)(?!.*\\\\)[^/]+(?:/[^/]+)*$" },
        { "not": { "pattern": "(^|/)(\\.{1,2}|\\.git)(/|$)" } }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId", "role", "workspaceId"],
      "properties": {
        "agentId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
        "role": { "enum": ["architect", "builder", "security", "qa", "researcher"] },
        "workspaceId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,256}$" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "catalogRevisionSha256",
        "authorizationContextSha256",
        "risk"
      ],
      "properties": {
        "decisionId": { "$ref": "#/$defs/uuid" },
        "catalogRevisionSha256": { "$ref": "#/$defs/sha256" },
        "authorizationContextSha256": { "$ref": "#/$defs/sha256" },
        "risk": {
          "enum": ["read_only", "workspace_write", "network", "destructive", "privileged"]
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "macSha256"],
      "properties": {
        "keyId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
        "macSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "readText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "relativePath", "startLine", "maxLines"],
      "properties": {
        "name": { "const": "workspace.read_text" },
        "relativePath": { "$ref": "#/$defs/safeRelativePath" },
        "startLine": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maxLines": { "type": "integer", "minimum": 1, "maximum": 400 }
      }
    },
    "writeText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "relativePath", "content", "contentSha256"],
      "properties": {
        "name": { "const": "workspace.write_text" },
        "relativePath": { "$ref": "#/$defs/safeRelativePath" },
        "content": { "type": "string", "maxLength": 1048576 },
        "contentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "execute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "program",
        "arguments",
        "argumentsSha256",
        "timeoutMs",
        "sandboxProfileSha256"
      ],
      "properties": {
        "name": { "const": "system.execute" },
        "program": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "arguments": {
          "type": "array",
          "maxItems": 128,
          "items": { "type": "string", "maxLength": 4096 }
        },
        "argumentsSha256": { "$ref": "#/$defs/sha256" },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000 },
        "sandboxProfileSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "executionAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contractVersion",
        "authority",
        "actionId",
        "missionId",
        "traceparent",
        "sequence",
        "nonce",
        "issuedAtUnixMs",
        "expiresAtUnixMs",
        "identity",
        "policy",
        "operation",
        "auth"
      ],
      "properties": {
        "kind": { "const": "execution_action" },
        "contractVersion": { "const": "goliath.control-plane.execution.v2" },
        "authority": { "const": "supergateway" },
        "actionId": { "$ref": "#/$defs/uuid" },
        "missionId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
        "traceparent": { "$ref": "#/$defs/traceparent" },
        "sequence": { "type": "integer", "minimum": 1 },
        "nonce": { "type": "string", "pattern": "^[0-9a-f]{32,128}$" },
        "issuedAtUnixMs": { "type": "integer", "minimum": 0 },
        "expiresAtUnixMs": { "type": "integer", "minimum": 0 },
        "identity": { "$ref": "#/$defs/identity" },
        "policy": { "$ref": "#/$defs/policy" },
        "operation": {
          "oneOf": [
            { "$ref": "#/$defs/readText" },
            { "$ref": "#/$defs/writeText" },
            { "$ref": "#/$defs/execute" }
          ]
        },
        "auth": { "$ref": "#/$defs/auth" }
      }
    },
    "executionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contractVersion",
        "actionId",
        "traceparent",
        "sequence",
        "component",
        "outcome",
        "operationName",
        "inputBytes",
        "outputBytes",
        "artifactSha256",
        "errorCode",
        "auth"
      ],
      "properties": {
        "kind": { "const": "execution_receipt" },
        "contractVersion": { "const": "goliath.control-plane.receipt.v2" },
        "actionId": { "$ref": "#/$defs/uuid" },
        "traceparent": { "$ref": "#/$defs/traceparent" },
        "sequence": { "type": "integer", "minimum": 1 },
        "component": { "const": "super-orchestrateur" },
        "outcome": { "enum": ["succeeded", "denied", "failed"] },
        "operationName": {
          "enum": ["workspace.read_text", "workspace.write_text", "system.execute"]
        },
        "inputBytes": { "type": "integer", "minimum": 0 },
        "outputBytes": { "type": "integer", "minimum": 0 },
        "artifactSha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "errorCode": {
          "anyOf": [
            { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
            { "type": "null" }
          ]
        },
        "auth": { "$ref": "#/$defs/auth" }
      }
    }
  }
}
