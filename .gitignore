# macOS
.DS_Store

# Xcode
*.xcworkspace
xcuserdata/
DerivedData/
*.xcodeproj
build/
*.xcarchive
*.dmg

# Swift Package Manager
.build/
Package.resolved
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/

# XcodeGen's project is generated, but the SwiftPM lock is source-controlled so
# CI and release builds consume reviewed revisions instead of resolving anew.
!Throttle.xcodeproj/
Throttle.xcodeproj/*
!Throttle.xcodeproj/project.xcworkspace/
Throttle.xcodeproj/project.xcworkspace/*
!Throttle.xcodeproj/project.xcworkspace/xcshareddata/
Throttle.xcodeproj/project.xcworkspace/xcshareddata/*
!Throttle.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
!Throttle.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Misc
*.swp
*.swo

# Audit / smoke-test scratch
audit-output/
codesign[0-9]*
build.log

# Claude Design source folders (kept locally only)
Untitled*.icon/

# Generated by xcodegen from project.yml
Throttle/Info.plist

# Source PNGs from Claude Design exports (kept locally, sliced into Assets.xcassets)
Untitled*.png
.design-tmp/

# Coverage + runtime scratch (not source)
default.profraw
lancedb/
.claude/scheduled_tasks.lock
