    "Your portfolio remains yours": { "extractionState": "manual", "localizations": { "fr": { "stringUnit": { "state": "translated", "value": "Votre portefeuille reste le vôtre" } } } },
    " AI output is labelled, bounded, and never treated as proof.": { "extractionState": "manual", "localizations": { "fr": { "stringUnit": { "state": "translated", "value": " La sortie IA est signalée, limitée et jamais considérée comme une preuve." } } } },
    "%lld capabilities · %lld tools · %lld workflows": { "extractionState": "manual", "localizations": { "fr": { "stringUnit": { "state": "translated", "value": "%lld capacités · %lld outils · %lld flux" } } } },
    "%lld discovery roots. The saved profile can later be exported as JSON or YAML.": { "extractionState": "manual", "localizations": { "fr": { "stringUnit": { "state": "translated", "value": "%lld racines de découverte. Le profil enregistré pourra être exporté en JSON ou YAML." } } } },
    "%lld selected projects": { "extractionState": "manual", "localizations": { "fr": { "stringUnit": { "state": "translated", "value": "%lld projets sélectionnés" } } } },
    "Add one or more project folders to continue.": { "extractionState": "manual", "localizations": { "fr": { "stringUnit": { "state": "translated", "value": "Ajoutez un ou plusieurs dossiers de projets pour continuer." } } } },
    "Aliases": { "extractionState": "manual", "localizations": { "fr": { "stringUnit": { "state": "translated", "value": "Alias" } } } },
    "Apple Foundation Models is ready on this Mac. Suggestions stay on-device.": { "extractionState": "manual", "localizations": { "fr": { "stringUnit": { "state": "translated", "value": "Apple Foundation Models est prêt sur ce Mac. Les suggestions restent sur l’appareil." } } } },
    "Apple Foundation Models · on-device": { "extractionState": "manual", "localizations": { "fr": { "stringUnit": { "state": "translated", "value": "Apple Foundation Models · sur l’appareil" } } } },
